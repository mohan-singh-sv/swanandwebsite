# Leave empty for `npm run dev` and for the Netlify build.
# Vite (local) and netlify.toml (live) proxy /api to the backend.
# A full URL here makes the browser call that host directly and fails CORS.
VITE_API_BASE_URL=
VITE_LICENSE_KEY=10000002
VITE_WEBSITE_API_SECRET=your-website-api-secret
VITE_RAZORPAY_KEY_ID=
